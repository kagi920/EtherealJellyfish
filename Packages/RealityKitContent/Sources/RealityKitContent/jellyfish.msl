#include <metal_stdlib>
#include <RealityKit/RealityKit.h>

using namespace metal;

struct JellyfishParameters {
    float handProximity;
    float fftMagnitudes[512];
};

[[visible]]
void jellyfishShader(realitykit::surface_parameters params)
{
    float3 baseColor = float3(0.1, 0.3, 0.8);
    float pulse = 0.0;

    JellyfishParameters jellyfishParams;
    params.custom_parameter("fftMagnitudes", jellyfishParams.fftMagnitudes, 512);

    if (params.is_particle()) {
        float totalMagnitude = 0.0;
        for (int i = 0; i < 512; i++) {
            totalMagnitude += jellyfishParams.fftMagnitudes[i];
        }

        pulse = totalMagnitude * 0.001;
    }

    float3 emissiveColor = baseColor * (1.0 + pulse);
    params.surface().set_emissive_color(emissiveColor);

    float alpha = params.particle().opacity();
    params.surface().set_opacity(alpha * 0.65);
}
